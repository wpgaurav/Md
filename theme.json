				},
				{
					"name": "Thistle",
					"slug": "thistle",
					"color": "#d8bfd8"
				},
				{
					"name": "Yellow Green",
					"slug": "yellow-green",
					"color": "#9acd32"
				},
				{
					"name": "Bordered",
					"slug": "bordered",
					"color": "#e5e7eb"
				},
				{
					"name": "BG Highlight",
					"slug": "bg-highlight",
					"color": "#111827"
				},
				{
					"name": "Off White",
					"slug": "offwhite",
					"color": "#F6F6F6"
				},
				{
					"name": "Subtle Green",
					"slug": "subtle-green",
					"color": "#117c68"
				},
				{
					"name": "Green Card",
					"slug": "green-card",
					"color": "#f1fdf8"
				},
				{
					"name": "Orange Card",
					"slug": "orange-card",
					"color": "#fef1f0"
				},
				{
					"name": "Red Card",
					"slug": "red-card",
					"color": "#ffe7e7"
				},
				{
					"name": "My Yellow",
					"slug": "my-yellow",
					"color": "#ffd700"
				},
				{
					"name": "Latest Green",
					"slug": "latest-green",
					"color": "#6fa11e"
				},
				{
					"name": "Shade Yellow",
					"slug": "shade-yellow",
					"color": "#ffdf88"
				},
				{
					"name": "Latest Red",
					"slug": "latest-red",
					"color": "#c0392b"
				},
				{
					"name": "TextShade",
					"slug": "textshade",
					"color": "#080808"
				},
				{
					"name": "Blue",
					"slug": "blue",
					"color": "#3533cd"
				}
			],
			"gradients": [
				{
					"slug": "subtle-green-to-light",
					"gradient": "linear-gradient(180deg, #f1fdf8, #ffffff)",
					"name": "Subtle Green to Light"
				},
				{
					"slug": "button",
					"gradient": "linear-gradient(to bottom, #F7B500, #C0392B)",
					"name": "Button"
				},
				{
					"slug": "brand-blue",
					"gradient": "linear-gradient(135deg, #262A5D, #3533cd)",
					"name": "Brand Blue"
				},
				{
					"slug": "brand-blue-alt",
					"gradient": "linear-gradient(135deg, #262A5D, #1b1a91, #46097c)",
					"name": "Brand Blue Alt"
				},
				{
					"slug": "primary-to-accent",
					"gradient": "linear-gradient(135deg, #C0392B, #F7B500)",
					"name": "Primary to Accent"
				},
				{
					"slug": "secondary-to-blue",
					"gradient": "linear-gradient(45deg, #262A5D, #3533cd)",
					"name": "Secondary to Blue"
				},
				{
					"slug": "accent-to-offwhite",
					"gradient": "linear-gradient(90deg, #F7B500, #F6F6F6)",
					"name": "Accent to Off White"
				},
				{
					"slug": "light-peach-to-white",
					"gradient": "linear-gradient(180deg, #ffdab9, #ffffff)",
					"name": "Light Peach to White"
				},
				{
					"slug": "yellow-green-to-latest-green",
					"gradient": "linear-gradient(135deg, #9acd32, #6fa11e)",
					"name": "Yellow Green to Latest Green"
				},
				{
					"slug": "dark-mode-bg",
					"gradient": "linear-gradient(180deg, #111827, #080808)",
					"name": "Dark Mode Background"
				}
				]
		},
		"layout": {
			"contentSize": "850px",
			"wideSize": "1024px"
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"blockGap": true,
        	"margin": true,
        	"padding": true,
        	"units": ["%","px","em","rem","vh","vw"],
        	"spacingScale": {
            	"steps": 1
        	},
        	"spacingSizes": [
				{
					"name": "3xs",
					"size": "clamp(0.41rem, calc(0.04vw + 0.4rem), 0.44rem)",
					"slug": "10"
				},
				{
					"name": "2xs",
					"size": "clamp(0.51rem, calc(0.16vw + 0.48rem), 0.62rem)",
					"slug": "20"
				},
				{
					"name": "xs",
					"size": "clamp(0.64rem, calc(0.36vw + 0.57rem), 0.88rem)",
					"slug": "30"
				},
				{
					"name": "s",
					"size": "clamp(0.8rem, calc(0.67vw + 0.67rem), 1.24rem)",
					"slug": "40"
				},
				{
					"name": "m",
					"size": "clamp(1.2rem, calc(1.25vw + 0.81rem), 1.95rem)",
					"slug": "50"
				},
				{
					"name": "l",
					"size": "clamp(1.25rem, calc(1.87vw + 0.88rem), 2.47rem)",
					"slug": "60"
				},
				{
					"name": "xl",
					"size": "clamp(1.56rem, calc(2.96vw + 0.97rem), 3.5rem)",
					"slug": "70"
				},
				{
					"name": "2xl",
					"size": "clamp(1.95rem, calc(4.58vw + 1.04rem), 4.95rem)",
					"slug": "80"
				}
			]
		},
		"typography": {
			"customFontSize": true,
			"lineHeight": true,
			"defaultFontSizes": false,
			"fluid": true,
			"fontSizes": [
				{
					"size": "clamp(0.74rem, calc(-0.05vw + 0.75rem), 0.7rem)",
					"slug": "extra-small",
					"name": "Extra Small"
				},
				{
					"size": "clamp(0.89rem, calc(0.08vw + 0.87rem), 0.94rem)",
					"slug": "small",
					"name": "Small"
				},
				{
					"size": "clamp(1.06rem, calc(0.29vw + 1rem), 1.25rem)",
					"slug": "base",
					"name": "Base"
				},
				{
					"size": "clamp(1.15rem, calc(0.39vw + 1.1rem), 1.4rem)",
					"slug": "medium",
					"name": "Medium"
				},
				{
					"size": "clamp(1.27rem, calc(0.6vw + 1.16rem), 1.67rem)",
					"slug": "large",
					"name": "Large"
				},
				{
					"size": "clamp(1.53rem, calc(1.06vw + 1.32rem), 2.22rem)",
					"slug": "x-large",
					"name": "Extra Large"
				},
				{
					"size": "clamp(1.84rem, calc(1.72vw + 1.49rem), 2.96rem)",
					"slug": "xx-large",
					"name": "Super Large"
				},
				{
					"size": "clamp(2.2rem, calc(2.67vw + 1.67rem), 3.95rem)",
					"slug": "xxx-large",
					"name": "Triple Large"
				},
				{
					"size": "clamp(2.64rem, calc(4vw + 1.84rem), 5.26rem)",
					"slug": "gigantic",
					"name": "Gigantic"
				}
			]
		},
		"useRootPaddingAwareAlignments": true
	},
	"styles": {
		"spacing": {
			"blockGap": "1.2rem"
		},
		"blocks": {
			"core/heading": {
				"typography": {
					"lineHeight": "calc(1.1em - 2px)"
				}
			},
			"core/button": {
				"color": {
					"background": "var:preset|color|primary",
					"text": "var:preset|color|white"
				},
				"border": {
					"radius": "var(--radius-m)"
				}
			},
			"core/group": {
				"spacing": {
					"padding": {
						"left": "var:preset|spacing|60",
						"right": "var:preset|spacing|60",
						"bottom": "var:preset|spacing|60",
						"top": "var:preset|spacing|60"
					}
				}
			},
			"core/image": {
				"spacing": {
					"margin": {
						"bottom": "var:preset|spacing|60"
					}
				}
			},
			"core/featured-image": {
				"spacing": {
					"margin": {
						"bottom": "var:preset|spacing|60"
					}
				}
			},
			"core/media-text": {
				"spacing": {
					"margin": {
						"bottom": "var:preset|spacing|60"
					}
				}
			}
		},
		"elements": {
			"link": {
				"color": {
					"text": "var:preset|color|primary"
				}
			}
		}
	}
}
